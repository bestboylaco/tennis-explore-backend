# Server
PORT=3000

# AWS S3 (services/s3Service.js, s3.js)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Ollama (services/llmService.js) - model name used for chat completions
OLLAMA_MODEL=llama3.1:8b

# Not read from .env, but required running locally on their default ports:
# - Ollama server at http://localhost:11434 (chat model above + "nomic-embed-text" for embeddings)
# - Qdrant vector DB at localhost:6333
